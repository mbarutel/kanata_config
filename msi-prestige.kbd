(defcfg
  linux-dev "/dev/input/event3"
  process-unmapped-keys yes
)

(defsrc
  esc  f1   f2   f3   f4   f5        f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5         6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t         y    u    i    o    p    [    ]    \
  caps a    s    d    f    g         h    j    k    l    ;    '    ret
  lsft z    x    c    v    b         n    m    ,    .    /    rsft
  lctl lmet lalt           spc                 ralt ssrq rmet
)

(deflayer colemak
  caps  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    g    j    l    u    y    '    [    ]    \
  @esc_met a    r    s    t    d    h    n    e    i    o    ;    @ret_rmet
  lsft @lmod_z @lmod_x @lmod_c @lmod_v    @tmx_b    k    @lmod_m    @lmod_,    @lmod_.    @lmod_/    rsft
  lalt @lmet_sft @del_lctl           @spc_nav              @bspc_rctl ssrq @rmet_sft
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lmet lalt  lctl lsft @tmx_ldr    caps left down up   right _    _
  _    _    _    _    _    _    _    home _    _    end   _
  _    _    _              _                   _    _    _
)

(defalias
  ;; tmux leader
  tmx_ldr (multi lctl b)
  tmx_b (tap-hold-release 200 200 b @tmx_ldr)

  ;; sft met
  lmet_sft (multi lmet lsft)
  rmet_sft (multi rmet rsft)

  ;; tap for space, hold to toggle nav layer
  spc_nav (tap-hold-release $tap-time $hold-time spc (layer-toggle nav))
  ;; tap for escape, hold for left meta
  esc_met (tap-hold-release $tap-time $hold-time esc lmet)
  ;; tap for return, hold for right meta
  ret_rmet (tap-hold-release $tap-time $hold-time ret rmet)
  ;; tap for delete, hold for left control
  del_lctl (tap-hold-release $tap-time $hold-time del lctl)
  ;; tap for backspace, hold for right control
  bspc_rctl (tap-hold-release $tap-time $hold-time bspc rctl)

  ;; bottom row mods
  lmod_z (tap-hold-release 200 200 z lmet)
  lmod_x (tap-hold-release 200 200 x lalt)
  lmod_c (tap-hold-release 200 200 c lctl)
  lmod_v (tap-hold-release 200 200 v lsft)

  lmod_m (tap-hold-release 200 200 m lsft)
  lmod_, (tap-hold-release 200 200 , lctl)
  lmod_. (tap-hold-release 200 200 . lalt)
  lmod_/ (tap-hold-release 200 200 / lmet)
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slofew to release keys and index
  ;; fingers faster.
  tap-time 160
  hold-time 160
  hold-time-slow 250
)
