
(defsrc
  esc  f1   f2   f3   f4   f5        f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5         6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t         y    u    i    o    p    [    ]    \
  caps a    s    d    f    g         h    j    k    l    ;    '    ret
  lsft z    x    c    v    b         n    m    ,    .    /    rsft
  fn lctl lalt lmet           spc                 rmet ralt
)

(deflayer colemak
  caps _    _    _    _    _         _    _    _    _    _    _    _
  grv  @one    @two    @three    @four    @five    @six    @seven    @eight    @nine    @zero    -    =    @scr_sht_cpy
  tab  q    w    f    p    g    j    l    u    y    '    [    ]    \
  @esc_met a    r    s    t    d    h    n    e    i    o    ;    @ret_rmet
  @lsft_sticky @z_gui    @x_alt    @c_ctl    @v_sft    @b_tmux    k    @m_sft    @comma_ctl    @dot_alt    @slsh_gui    @rsft_sticky
  @fn lctl lalt @del_lctl           @spc_nav                 @bspc_rctl ralt
)

(deflayer source
  _ _    _    _    _    _         _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    
  _    _    _    _    _    _    _    _ _    _    _   _
  @fn _    _    _              _                   _    _    
)

(deflayer nav
  _ _    _    _    _    _         _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    @scr_sht
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lmet lalt  lctl lsft @ctrl_b    caps left down up   right _    _
  _    _    _    _    _    _    _    home _    _    end   _
  _ _    _    @alt_del              _                   @alt_bscp    _    
)

(deflayer fn
  _  🔅   🔆   @src @clm nop2 nop3 ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lmet lalt  lctl lsft _    caps left down up   right _    _
  _    _    _    _    _    _    _    home _    _    end   _
  _ _    _    _              _                   _    _    
)

(defalias
  ;; Layer switching
  src (layer-switch source)
  clm (layer-switch colemak)
  fn (layer-toggle fn)

  ;; Word to word bspc and del
  alt_bscp (multi ralt bspc)
  alt_del (multi lalt del)

  ;; Tmux Leader Combo
  ctrl_b (multi lctrl b)
  b_tmux (tap-hold-release $tap-time $hold-time b @ctrl_b)

  ;; Sticky Shift
  rsft_sticky (one-shot 1000 rsft)
  lsft_sticky (one-shot 1000 lsft)

  ;; Screenshots
  scr_sht (multi lmet lsft 4)
  scr_sht_cpy (multi lmet lsft lctrl 4)

  ;; tap for space, hold to toggle nav layer
  spc_nav (tap-hold-release $tap-time $hold-time spc (layer-toggle nav))

  ;; tap for escape, hold for left meta
  esc_met (tap-hold-release $tap-time $hold-time esc lmet)

  ;; tap for return, hold for left meta
  ret_rmet (tap-hold-release $tap-time $hold-time ret rmet)

  ;; tap for delete, hold for left control
  del_lctl (tap-hold-release $tap-time $hold-time del lctl)

  ;; tap for backspace, hold for right control
  bspc_rctl (tap-hold-release $tap-time $hold-time bspc rctl)

  ;; Bottom row mods Left Side
  z_gui (tap-hold-release $tap-time $hold-time z lmet)
  x_alt (tap-hold-release $tap-time $hold-time x lalt)
  c_ctl (tap-hold-release $tap-time $hold-time c lctl)
  v_sft (tap-hold-release $tap-time $hold-time v lsft)

  ;; Bottom row mods Right Side
  m_sft (tap-hold-release $tap-time $hold-time m lsft)
  comma_ctl (tap-hold-release $tap-time $hold-time , lctl)
  dot_alt (tap-hold-release $tap-time $hold-time . lalt)
  slsh_gui (tap-hold-release $tap-time $hold-time / lmet)

  ;; Workspace moving shortcuts
  alt_one (multi lalt 1)
  alt_two (multi lalt 2)
  alt_three (multi lalt 3)
  alt_four (multi lalt 4)
  alt_five (multi lalt 5)
  alt_six (multi lalt 6)
  alt_seven (multi lalt 7)
  alt_eight (multi lalt 8)
  alt_nine (multi lalt 9)
  alt_zero (multi lalt 0)

  one (tap-hold-release $tap-time $hold-time 1 @alt_one)
  two (tap-hold-release $tap-time $hold-time 2 @alt_two)
  three (tap-hold-release $tap-time $hold-time 3 @alt_three)
  four (tap-hold-release $tap-time $hold-time 4 @alt_four)
  five (tap-hold-release $tap-time $hold-time 5 @alt_five)
  six (tap-hold-release $tap-time $hold-time 6 @alt_six)
  seven (tap-hold-release $tap-time $hold-time 7 @alt_seven)
  eight (tap-hold-release $tap-time $hold-time 8 @alt_eight)
  nine (tap-hold-release $tap-time $hold-time 9 @alt_nine)
  zero (tap-hold-release $tap-time $hold-time 0 @alt_zero)
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slofew to release keys and index
  ;; fingers faster.
  tap-time 160
  hold-time 160
  hold-time-slow 200
)
