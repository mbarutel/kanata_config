
(defsrc
  esc  f1   f2   f3   f4   f5        f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5         6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t         y    u    i    o    p    [    ]    \
  caps a    s    d    f    g         h    j    k    l    ;    '    ret
  lsft z    x    c    v    b         n    m    ,    .    /    rsft
  fn lctl lalt lmet           spc                 rmet ralt
)

(deflayer colemak
  caps _    _    _    _    _         _    _    _    _    _    _    _
  grv  1    2    3    4    5    6    7    8    9    0    -    =    @scr_sht_cpy
  tab  q    w    f    p    g    j    l    u    y    '    [    ]    \
  @esc_met a    r    s    t    d    h    n    e    i    o    ;    @ret_rmet
  @lsft_sticky z    x    c    v    b    k    m    ,    .    /    @rsft_sticky
  @fn lctl lalt @del_lctl           @spc_nav                 @bspc_rctl ralt
)

(deflayer source
  _ _    _    _    _    _         _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    
  _    _    _    _    _    _    _    _ _    _    _   _
  @fn _    _    _              _                   _    _    
)

(deflayer nav
  _ _    _    _    _    _         _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    @scr_sht
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lmet lalt  lctl lsft @ctrl_b    caps left down up   right _    _
  _    _    _    _    _    _    _    home _    _    end   _
  _ _    _    @alt_del              _                   @alt_bscp    _    
)

(deflayer fn
  _  🔅   🔆   @src @clm nop2 nop3 ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lmet lalt  lctl lsft _    caps left down up   right _    _
  _    _    _    _    _    _    _    home _    _    end   _
  _ _    _    _              _                   _    _    
)

(defalias
  src (layer-switch source)
  clm (layer-switch colemak)

  fn (layer-toggle fn)

  alt_bscp (multi ralt bspc)
  alt_del (multi lalt del)

  ctrl_b (multi lctrl b)

  rsft_sticky (one-shot 1000 rsft)
  lsft_sticky (one-shot 1000 lsft)

  ;; Screenshots
  scr_sht (multi lmet lsft 4)
  scr_sht_cpy (multi lmet lsft lctrl 4)

  ;; tap for space, hold to toggle nav layer
  spc_nav (tap-hold-release $tap-time $hold-time spc (layer-toggle nav))

  ;; tap for escape, hold for left meta
  esc_met (tap-hold-release $tap-time $hold-time esc lmet)

  ;; tap for return, hold for left meta
  ret_rmet (tap-hold-release $tap-time $hold-time ret rmet)

  ;; tap for delete, hold for left control
  del_lctl (tap-hold-release $tap-time $hold-time del lctl)

  ;; tap for backspace, hold for right control
  bspc_rctl (tap-hold-release $tap-time $hold-time bspc rctl)
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slofew to release keys and index
  ;; fingers faster.
  tap-time 160
  hold-time 160
  hold-time-slow 200
)
