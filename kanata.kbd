
(defsrc
  esc  f1   f2   f3   f4   f5        f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5         6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t         y    u    i    o    p    [    ]    \
  caps a    s    d    f    g         h    j    k    l    ;    '    ret
  lsft z    x    c    v    b         n    m    ,    .    /    rsft
  lctl lalt lmet           spc                 rmet ralt
)

(deflayer colemak
  caps  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    g    j    l    u    y    '    [    ]    \
  esc a    r    s    t    d    h    n    e    i    o    ;    ret
  lsft z    x    c    v    b    k    m    ,    .    /    rsft
  lctl lalt lmet           @spc_nav                 rmet ralt
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    lmet lalt  lctl lsft _    caps left down up   right _    _
  _    _    _    _    _    _    _    home _    _    end   _
  _    _    _              _                   _    _    _
)

(defalias
  ;; tap for space, hold to toggle nav layer
  spc_nav (tap-hold-release 200 200 spc (layer-toggle nav))
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slofew to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 200
  hold-time-slow 300
)
